# Copy this file to .env for Docker Compose and fill every blank value.
# Never commit .env or any real credential. Spring Boot launched directly does
# not automatically import this file; export the variables in your shell/IDE.

# --- SECURITY SECRETS (required outside the test profile) ---
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
GOOGLE_GENAI_API_KEY=
GROK_API_KEY=

# --- DATABASE ---
DB_URL=jdbc:postgresql://localhost:5433/sakuralearn_db
DB_USERNAME=admin
DB_PASSWORD=
DB_NAME=sakuralearn_db

# --- INFRASTRUCTURE ---
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_SERVERS=localhost:9092
MAIL_HOST=localhost
MAIL_PORT=1025

# --- MINIO ---
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sakuralearn-media

# --- APP URLS ---
SPRING_PROFILES_ACTIVE=dev
APP_VERIFY_URL=http://localhost:3000/verify-email
APP_RESET_URL=http://localhost:3000/reset-password
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/redirect

# --- ADMIN SEEDING (dev only; minimum 12 characters, no known weak value) ---
INITIAL_ADMIN_PASSWORD=
